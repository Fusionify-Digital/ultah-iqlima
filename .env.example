# Salin jadi .env.local untuk tes di komputer, dan isi juga di Vercel:
# Project > Settings > Environment Variables

# Gmail pengirim + App Password 16 huruf (https://myaccount.google.com/apppasswords)
GMAIL_USER=kamu@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Email dia (penerima di hari ulang tahun)
BIRTHDAY_EMAIL_TO=

# Penerima email tes (?test=1 dan npm run email:test). Kosongkan untuk pakai GMAIL_USER.
TEST_EMAIL_TO=

# Kunci rahasia acak untuk memanggil /api/birthday-email (dipakai di header cron-job.org)
CRON_SECRET=

# Alamat web yang sudah online (wajib untuk npm run email:test, opsional di Vercel)
SITE_URL=
